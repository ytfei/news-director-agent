# ---- 应用 ----
APP_ENV=dev
LOG_LEVEL=INFO
API_PORT=8000

# ---- 数据库 ----
DATABASE_URL=postgresql+asyncpg://nda:nda@localhost:5433/nda
# 同步驱动，仅 Alembic 使用
DATABASE_URL_SYNC=postgresql+psycopg://nda:nda@localhost:5433/nda

# ---- Redis / 队列 ----
REDIS_URL=redis://localhost:6379
ARQ_MAX_JOBS=8
ARQ_JOB_TIMEOUT=900

# ---- 数据源 ----
TUSHARE_TOKEN=
TUSHARE_QPS=3.0
TUSHARE_TIMEOUT=30

# ---- Embedding ----
EMBEDDING_PROVIDER=volcengine
EMBEDDING_MODEL=doubao-embedding-vision

# ---- 同步 ----
SYNC_MAX_CONCURRENT_CONNECTORS=2

# ---- 向量（Spike #4 定模型后固定；换维度需重建 HNSW） ----
EMBEDDING_DIM=1024
