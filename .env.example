# ============================================================================
# Docker Compose 变量（复制为仓库根目录的 .env，compose 会自动读取）
#
#   cp .env.example .env
#
# 注意：这个文件只服务 docker compose。
# 本地不起容器、直接用 uv 跑代码时，配置在 apps/api/.env（见 apps/api/.env.example）。
# ============================================================================

# ---- 应用 ----
APP_ENV=prod
LOG_LEVEL=INFO

# ---- 端口（宿主机） ----
API_PORT=8000
WEB_PORT=8080

# ---- 数据库 ----
POSTGRES_PASSWORD=nda

# ---- 模型（OpenAI 兼容协议；火山方舟 Ark） ----
# 私有化时把 OPENAI_BASE_URL 换成自建 vLLM / Ollama 的同协议地址即可
OPENAI_BASE_URL=https://ark.cn-beijing.volces.com/api/plan/v3
OPENAI_API_KEY=
# 大语言模型（推理模型：completion token 中绝大部分是 reasoning token，成本高、延迟长）
# 三档模型（seed 2.1 系列；实测三款都是推理模型，reasoning 占 97~100%）
#   pro   1M   旗舰深度推理   分类 194tok/10s · 核查 4285tok/108s
#   turbo 256k 均衡主力       分类  37tok/ 2s · 核查 3613tok/ 56s   <- 甜点
#   lite  256k 轻量通用       分类 201tok/ 5s · 核查 3055tok/ 48s
# 注意：lite 在简单任务上并不比 turbo 省（201 vs 37），默认档因此选 turbo
LLM_MODEL_PRO=doubao-seed-2.1-pro
LLM_MODEL_TURBO=doubao-seed-2.1-turbo
LLM_MODEL_LITE=doubao-seed-2.1-lite
LLM_TIER_DEFAULT=turbo
LLM_TIER_OVERRIDES={}
LLM_IS_REASONING=true
LLM_TIMEOUT=180
LLM_MAX_RETRIES=2
# 向量模型（实测 2048 维）
EMBEDDING_MODEL=doubao-embedding-vision
EMBEDDING_BATCH_SIZE=32
EMBEDDING_CONCURRENCY=2
# 0 = 不截断。pgvector 索引上限 2000 维，需建索引时设 <=2000（统一截断，精度下降）
EMBEDDING_TRUNCATE_TO=0

# ★ 必须与数据库中 news_items.embedding 的实际维度一致，否则写入直接报错。
#   检查：make doctor
#   当前库是 vector(2048)；换模型 = 需要重建向量列与索引（TODO P0-2）。
EMBEDDING_DIM=2048

# ---- 对象存储（公告 PDF / 导出文件） ----
MINIO_ROOT_USER=nda
MINIO_ROOT_PASSWORD=nda123456

# ---- 数据源 ----
# 留空则同步会失败并提示"未配置 token"；建议填真实 token 以启用真机同步
TUSHARE_TOKEN=
TUSHARE_QPS=3.0

# ---- 队列与并发 ----
ARQ_MAX_JOBS=8
ARQ_JOB_TIMEOUT=900
# 单批检查并发上限：其余排队，避免同时打满 LLM 造成成本尖峰
REVIEW_MAX_CONCURRENCY=5
